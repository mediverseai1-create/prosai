# Public site URL (used for auth email links). Set to your Vercel domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Needed for usage metering and the payment webhook.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (Gemini). AI research is disabled when unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Payment links (defaults are built in; set to override)
NEXT_PUBLIC_PAYMENT_LINK_LAUNCH=https://selar.com/47plan?currency=USD
NEXT_PUBLIC_PAYMENT_LINK_GROWTH=https://selar.com/57plan?currency=USD
NEXT_PUBLIC_PAYMENT_LINK_SCALE=https://selar.com/97plan?currency=USD

# Shared secret for POST /api/webhooks/payments (HMAC-SHA256 in x-prosai-signature)
# Long random string. Selar webhook URL: https://<site>/api/webhooks/selar?token=<this value>
SELAR_WEBHOOK_TOKEN=
PAYMENT_WEBHOOK_SECRET=
